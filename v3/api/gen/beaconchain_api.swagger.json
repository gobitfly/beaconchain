            "name": "dashboardId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "BeaconchainApiService"
        ]
      },
      "post": {
        "summary": "Creates a new Validator Dashboard",
