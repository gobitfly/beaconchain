  "paths": {
    "/api/v1/execution/block/{blockNumber}": {
      "get": {
        "summary": "Get execution blocks by execution block number",
        "operationId": "BeaconchainApiService_ExecutionBlock",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/ExecutionBlockResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "blockNumber",
            "description": "Provide one or more execution block numbers. Comma separated up to max 100.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "BeaconchainApiService"
        ]
      }
    },
    "/api/validatorDashboard": {
