{
    "dependencies": {
        "@pinia/nuxt": "^0.11.2",
        "@stripe/stripe-js": "^7.0.0",
        "@vueuse/core": "^13.0.0",
        "@vueuse/nuxt": "^13.0.0",
        "big.js": "^7.0.1",
        "echarts": "^5.6.0",
        "lodash-es": "^4.17.21",
        "pinia": "^3.0.3",
        "pinia-plugin-persistedstate": "^4.5.0",
        "qrcode.vue": "^3.6.0",
        "vee-validate": "^4.15.0",
        "vue": "latest",
        "vue-echarts": "^7.0.3",
        "vue-router": "latest"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.3.0",
        "@nuxt/test-utils": "^3.17.2",
        "@nuxtjs/i18n": "^10.0.6",
        "@playwright/test": "^1.51.1",
        "@primevue/nuxt-module": "^4.3.7",
        "@rollup/plugin-babel": "^6.0.4",
        "@stylistic/eslint-plugin": "^5.3.1",
        "@types/big.js": "^6.2.2",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.3.0",
        "@vee-validate/yup": "^4.15.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.38.0",
        "eslint-plugin-jsonc": "^2.21.0",
        "eslint-plugin-newline-destructuring": "^1.2.2",
        "eslint-plugin-perfectionist": "^4.15.1",
        "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
        "git-describe": "^4.1.1",
        "nuxt": "^4.1.2",
        "postcss": "^8.5.3",
        "sass": "^1.87.0",
        "typescript": "^5.9.2",
        "vue-tsc": "^3.0.6"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "name": "beaconchain-explorer",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "dev:mock:api": "NUXT_PUBLIC_IS_API_MOCKED=true npm run dev",
        "dev:mock:production": "NUXT_DEPLOYMENT_TYPE=production npm run dev",
        "dev:mock:staging": "NUXT_DEPLOYMENT_TYPE=staging npm run dev",
        "generate": "nuxt generate",
        "install:clean": "rm -rf node_modules && rm -rf package-lock.json && rm -rf .nuxt && rm -rf .output && npm install",
        "lint": "eslint . --report-unused-disable-directives",
        "lint:fix": "npm run lint -- --fix",
        "postinstall": "nuxt prepare",
        "preview": "nuxt preview",
        "test:e2e": "npx playwright test --config=tests/playwright.config.ts",
        "test:e2e:ui": "npm run test:e2e -- --ui",
        "tests-landing-page-hoodi": "ENV=hoodi.staging npx playwright test --config=tests/playwright.config.ts --grep @landing-page --ui",
        "tests-landing-page-mainnet": "ENV=mainnet.staging npx playwright test --config=tests/playwright.config.ts --grep @landing-page --ui",
        "typecheck": "npx nuxi typecheck",
        "validate": "npm run lint:fix && npm run typecheck"
    },
    "type": "module",
    "workspaces": [
        "layers/base"
    ]
}
