    },
    "engines": {
        "node": ">=22.0.0"
    },
    "name": "beaconchain-explorer",
    "overrides": {
        "vue": "latest"
    },
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev",
        "dev:mock:api": "NUXT_PUBLIC_IS_API_MOCKED=true npm run dev",
        "dev:mock:production": "NUXT_DEPLOYMENT_TYPE=production npm run dev",
        "dev:mock:staging": "NUXT_DEPLOYMENT_TYPE=staging npm run dev",
        "generate": "nuxt generate",
        "install:clean": "rm -rf node_modules && rm -rf package-lock.json && rm -rf .nuxt && rm -rf .output && npm install",
        "lint": "eslint . --report-unused-disable-directives",
        "lint:fix": "npm run lint -- --fix",
        "postinstall": "nuxt prepare",
        "preview": "nuxt preview",
        "test:e2e": "npx playwright test --config=tests/playwright.config.ts",
        "test:e2e:ui": "npm run test:e2e -- --ui",
        "typecheck": "npx nuxi typecheck",
        "validate": "npm run lint:fix && npm run typecheck"
    },
    "type": "module"
}
