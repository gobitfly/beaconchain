{
  "name": "beaconchain-monorepo",
  "version": "1.0.0",
  "description": "The explorer provides a comprehensive and easy to use interface for the upcoming Eth2 beacon chain. It makes it easy to view proposed blocks, follow attestations and monitor your staking activity.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check-style": "npm run eslint-js",
    "eslint-js": "eslint static/js",
    "eslint-html": "eslint v1/templates/**.html",
    "check-format": "npm run check-html && npm run check-js",
    "check-html": "prettier -c v1/templates/",
    "check-js": "prettier -c v1/static/js",
    "format": "npm run format-html && npm run format-js",
    "format-html": "prettier -w v1/templates/",
    "format-js": "prettier -w v1/static/js",
    "bundle-api-docs": "redocly bundle external@latest -o v1/static/openapi/bundled.yaml --config v1/static/openapi/redocly.yaml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobitfly/beaconchain-monorepo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gobitfly/beaconchain-monorepo/issues"
  },
  "homepage": "https://github.com/gobitfly/beaconchain-monorepo#readme",
  "dependencies": {
    "@redocly/cli": "^2.8.0",
    "eslint": "^8.18.0",
    "eslint-plugin-html": "^6.2.0",
    "prettier-plugin-go-template": "^0.0.13"
  },
  "devDependencies": {
    "espree": "^9.3.2",
    "prettier": "^2.8.0"
  }
}
